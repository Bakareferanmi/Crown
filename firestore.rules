rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == "admin";
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.staff_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.staff_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.staff_id == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
